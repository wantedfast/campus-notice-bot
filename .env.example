# Copy to .env.local for local development. Never commit real secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required for administrator login; choose a strong password (6+ characters).
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_URL=http://localhost:3000
DATABASE_PATH=./data/campus.sqlite
CHAT_TIMEOUT_MS=45000
# Enable only behind your own reverse proxy that REPLACES X-Forwarded-For.
TRUST_PROXY=false
